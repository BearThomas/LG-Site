# Public Appwrite Auth settings (served to the browser by /api/runtime-config.js)
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=lg

# D1 runtime policy. Use exact collection IDs separated by commas.
D1_PUBLIC_READ_COLLECTIONS=<posts-collection-id>,<comments-collection-id>,<confessions-collection-id>
D1_AUTHENTICATED_READ_COLLECTIONS=<profiles-collection-id>
D1_ANONYMOUS_WRITE_COLLECTIONS=
D1_ADMIN_USER_IDS=<your-appwrite-user-id>
D1_EMPTY_PERMISSIONS_PUBLIC=false
D1_API_BASE=/api/d1

# Local migration command only; not required by Pages runtime.
D1_DATABASE_NAME=lg-site-db
D1_DEFAULT_DATABASE_ID=<original-appwrite-database-id>

# Optional, only for a future server-side Appwrite export after the quota resets.
# Store it as a Cloudflare secret / local .dev.vars value, never in Git.
APPWRITE_API_KEY=

# Public identifiers consumed by /api/runtime-config.js
APPWRITE_DATABASE_IDS_JSON={}
APPWRITE_COLLECTION_IDS_JSON={}
