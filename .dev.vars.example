# Copy this file to .dev.vars for local development only.
# Never commit .dev.vars, .env, API keys, or token secrets.

APPWRITE_ENDPOINT=https://YOUR_REGION.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=YOUR_APPWRITE_PROJECT_ID
# Appwrite API Key scopes required: sessions.write and users.write
APPWRITE_API_KEY=YOUR_SERVER_API_KEY
AUTH_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BACKUP_ENCRYPT_KEY=64_HEX_CHAR_AES_256_KEY
CAMPUS_VERIFY_QUESTIONS=[{"id":"q1","question":"示例题目一","hint":"","answers":["答案"]},{"id":"q2","question":"示例题目二","hint":"","answers":["答案"]}]

D1_DATABASE_NAME=lg
D1_DATABASE_ID=31e5fcd9-e15b-492c-90d3-c4119fa7f39a

# Optional tuning
AUTH_SESSION_TTL_SECONDS=3600
AUTH_REFRESH_TTL_SECONDS=2592000
APP_TIMEZONE_OFFSET_MINUTES=480
POST_DAILY_LIMIT=5
COMMENT_DAILY_LIMIT=100
CONFESSION_DAILY_LIMIT=20
